# SQL Server 2025: its built-in administrator is sa (the image cannot rename it).
SQL_ADMIN_USER=sa
SQL_ADMIN_PASSWORD=
SQL_DATABASE=ArchiveroDockerDev
SQL_PORT=1435

# Service Bus emulator and its separate SQL Edge dependency.
# Set Y to accept the SQL Server and Service Bus emulator license terms.
ACCEPT_EULA=Y
MSSQL_SA_PASSWORD=
CONFIG_PATH=./AzureServiceBusEmulator/Config.json
SERVICEBUS_PORT=5672
EMULATOR_HTTP_PORT=5300
SQL_WAIT_INTERVAL=30

# Azurite custom account. Generate the key with: openssl rand -base64 32
BLOB_ACCOUNT_NAME=devstoreaccount1
BLOB_ACCOUNT_KEY=
BLOB_CONTAINER_NAME=archivero
BLOB_PORT=10000
REDIS_PORT=6379

# Initial application administrator (password at least 12 characters).
APP_ADMIN_USERNAME=admin
APP_ADMIN_PASSWORD=
# Generate a signing key with: openssl rand -base64 48
JWT_SIGNING_KEY=
